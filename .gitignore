# .gitignore - project root
# General
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyc

# Virtual environments
.env/
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# PyInstaller
*.manifest
*.spec

# Logs
*.log
logs/
*.log.*

# dotenv
.env
.env.*

# Editor directories and files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Editor swap files and backups
*~
*.swp
*.swo

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
*.sqlite3
*.db
coverage/

# Local config files
local_settings.py
secrets.yml

# Ignore compiled shared libraries
*.so

# End of .gitignore

